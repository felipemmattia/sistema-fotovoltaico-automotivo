# ESPHome Secrets Template for Epever Solar Monitoring
# Rename this file to secrets.yaml and fill in your network & API credentials

wifi_ssid: "Your_WiFi_SSID"
wifi_password: "Your_WiFi_Password"

fallback_ap_ssid: "Solar-ESP32S3-Fallback"
fallback_ap_password: "SolarFallbackAccessPointKey"

# Dashboard Backend HTTP Ingestion Endpoint URL
# Example: "http://192.168.1.100:3000/api/telemetry" or cloud URL "https://solar-dashboard.mydomain.com/api/telemetry"
dashboard_webhook_url: "http://192.168.1.100:3000/api/telemetry"

# Optional API Authentication Key for telemetry ingest security
telemetry_api_key: "solar_sec_key_production_2026_epever"
