# ESPHome Secrets Template for Epever Solar Monitoring
# Rename this file to secrets.yaml and fill in your network & API credentials

wifi_ssid: "Your_Primary_Hotspot_SSID"
wifi_password: "Your_Primary_Hotspot_Password"

# Additional fallback/institutional Wi-Fi networks (do NOT commit real credentials)
wifi_ssid_vw: "Optional_WiFi_2_SSID"
wifi_password_vw: "Optional_WiFi_2_Password"

wifi_ssid_cat8010_adm: "Optional_WiFi_3_SSID"
wifi_password_cat8010_adm: "Optional_WiFi_3_Password"

wifi_ssid_cat810_adm: "Optional_WiFi_4_SSID"
wifi_password_cat810_adm: "Optional_WiFi_4_Password"

wifi_ssid_cat8010_educ: "Optional_WiFi_5_SSID"
wifi_password_cat8010_educ: "Optional_WiFi_5_Password"

wifi_ssid_cat810_educ: "Optional_WiFi_6_SSID"
wifi_password_cat810_educ: "Optional_WiFi_6_Password"

fallback_ap_ssid: "Solar-ESP32S3-Fallback"
fallback_ap_password: "SolarFallbackAccessPointKey"

# Dashboard Backend HTTP Ingestion Endpoint URL
# Example: "http://192.168.1.100:3000/api/telemetry" or cloud URL "https://solar-dashboard.mydomain.com/api/telemetry"
dashboard_webhook_url: "http://192.168.1.100:3000/api/telemetry"

# Optional API Authentication Key for telemetry ingest security
telemetry_api_key: "solar_sec_key_production_2026_epever"
